# =============================================
# InternPilot — Environment Variables Template
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================

# ---- LLM Configuration ----
# Provider: "ollama", "openai", "anthropic", or other supported provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434

# Uncomment and fill for cloud providers:
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ---- Opportunity Provider API Keys ----
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# JSEARCH_API_KEY=your-jsearch-api-key

# ---- Application Settings ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Database ----
DATABASE_URL=sqlite:///./data/internpilot.db

# ---- Frontend ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
